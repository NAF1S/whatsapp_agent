# Hide Haven Customer Support Agent — configuration template
#
# Copy to .env and fill in the values:
#   cp .env.example .env
#
# SECRETS MUST BE FILLED IN. Never commit .env — it holds database, admin and WhatsApp
# credentials. The application no longer relies on hardcoded fallbacks for the values
# marked REQUIRED (see AGENT.md: leaked default credentials are an open risk).

# ─── Brain: primary provider ─────────────────────────────────────────────────
AI_PRIMARY_PROVIDER=deepseek
DEEPSEEK_API_KEY=            # REQUIRED — primary tool-calling model
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_EFFORT=low          # low | high | max

# ─── Brain: Gemini (fallback model, voice transcription, vision, embeddings) ──
GEMINI_API_KEY=              # REQUIRED — also used for embeddings (pgvector is VECTOR(768))
GEMINI_BRAIN_MODEL=gemini-2.5-flash
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_CHAT_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# ─── Supabase PostgreSQL (pgvector) ──────────────────────────────────────────
# Prefer the IPv4 session pooler host; an IPv6-only host fails on networks without IPv6.
DATABASE_URL=                # REQUIRED — used by the app and by scripts/backup.sh
DB_HOST=                     # REQUIRED
DB_PORT=5432
DB_USER=
DB_PASSWORD=                 # REQUIRED
DB_NAME=postgres
SUPABASE_URL=

# ─── Redis (BullMQ queue) ────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=              # REQUIRED — must match whatsapp_bridge/.env

# ─── WooCommerce store ───────────────────────────────────────────────────────
WOOCOMMERCE_URL=https://shop.hidehaven.me/wp-json/wc/v3
WOOCOMMERCE_CONSUMER_KEY=    # REQUIRED
WOOCOMMERCE_CONSUMER_SECRET= # REQUIRED
WORDPRESS_APP_PASSWORD=

# ─── WhatsApp ────────────────────────────────────────────────────────────────
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3001
WHATSAPP_ADMIN_PHONE=        # REQUIRED — where escalation reports are sent

# ─── Service & dashboard ─────────────────────────────────────────────────────
AGENT_PORT=3000
ADMIN_PASSWORD=              # REQUIRED — dashboard bearer token (no default)
WEBHOOK_SECRET=              # REQUIRED — shared with the WordPress plugin (no default)
HUMAN_HANDOFF_TIMEOUT_MINUTES=30   # minutes of human silence before the bot resumes
LOG_LEVEL=info
