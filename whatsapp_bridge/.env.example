# WhatsApp Baileys bridge — configuration template
#
# Copy to .env and fill in the values:
#   cp .env.example .env
#
# REDIS_PASSWORD must be identical to the value in agent/.env or the bridge cannot enqueue
# incoming messages (they are dropped, and customers get no reply).

BRIDGE_HTTP_PORT=3001
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=              # REQUIRED — must match agent/.env

# Where Baileys stores the WhatsApp session (creds.json et al).
# This directory IS the store's WhatsApp account: back it up, and never delete it.
AUTH_DIR=auth_info

LOG_LEVEL=info
